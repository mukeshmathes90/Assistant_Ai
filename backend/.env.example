# ============================================================
# College Admission Assistance & Visitor Queue System - Backend
# Copy this file to .env and adjust values as needed.
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Security ---
# Change this secret in production. Use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database (SQLite by default for the academic prototype) ---
DATABASE_URL=sqlite:///./college_queue.db

# --- College identity (used by the AI assistant branding/fallbacks) ---
COLLEGE_NAME=Nandha Engineering College (Autonomous)
COLLEGE_WEBSITE=https://nandhaengg.org/

# Public URL of the visitor web app, used for the reception QR codes.
# Leave empty to auto-detect this PC's LAN IP (http://<lan-ip>:5173) so phones
# on the same Wi-Fi can scan and open the chat. Set it when hosting, e.g.
# PUBLIC_BASE_URL=https://admissions.nandhaengg.org
PUBLIC_BASE_URL=

# --- AI Provider ---
# Options:
#   rules   -> built-in knowledge-base assistant (works offline, no extra deps). DEFAULT.
#   ollama  -> use a local Ollama model through the Ollama REST API.
#   gemini  -> use Google Gemini (needs GEMINI_API_KEY below).
AI_PROVIDER=rules

# Gemini settings (only used when AI_PROVIDER=gemini):
# Create a key at https://aistudio.google.com/apikey and never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Ollama settings (only used when AI_PROVIDER=ollama):
OLLAMA_BASE_URL=http://localhost:11434
# Must be a model you have actually pulled: run `ollama list` to see them.
# If the model is missing, the app auto-uses any pulled model as a fallback.
OLLAMA_MODEL=llama3:8b
# Optional API key header for Ollama proxies that require one (leave empty in normal use)
OLLAMA_API_KEY=

# --- WhatsApp Cloud API (PRIMARY messaging channel) ---
# The app also works without these (web chat + Telegram). See README
# "WhatsApp Integration" for the Meta test-number setup.
# Secrets: keep them only here / in the host's environment, never commit.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; enter the same value in Meta > WhatsApp > Configuration.
WHATSAPP_VERIFY_TOKEN=
# Meta App secret (App settings > Basic). When set, webhook signatures are
# verified. Leave empty only for local testing.
WHATSAPP_APP_SECRET=
# College WhatsApp number with country code, digits only (e.g. 15551234567
# for Meta's test number). Only used for the wa.me link / reception QR.
WHATSAPP_BUSINESS_NUMBER=
# Added to 10-digit numbers registered at the reception.
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_API_BASE=https://graph.facebook.com/v19.0

# --- Telegram Bot (alternative channel; long polling, no public URL needed) ---
# Create a bot with @BotFather, then paste the token here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
# Set to 0 to disable the bot without deleting the token.
TELEGRAM_POLLING=1